{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IkshvakuGeneralAwarenessQuestion",
  "description": "Standard schema for General Awareness questions in Ikshvaku Aptitude Arena (SSC CGL & CHSL PYQ standard).",
  "type": "object",
  "required": [
    "id",
    "subject",
    "topic",
    "subtopic",
    "difficulty",
    "question_type",
    "question",
    "options",
    "answer",
    "explanation",
    "estimated_time_seconds",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^GA-[A-Z0-9]+-[0-9]{6}$",
      "description": "Unique identifier formatted as GA-[TOPIC_CODE]-[6_DIGIT_SERIAL]."
    },
    "subject": {
      "type": "string",
      "const": "general_awareness"
    },
    "topic": { "type": "string", "minLength": 2 },
    "subtopic": { "type": "string", "minLength": 2 },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard", "very_hard"] },
    "question_type": { "type": "string", "enum": ["single_choice", "multiple_choice", "true_false"] },
    "question": { "type": "string", "minLength": 10 },
    "options": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "maxItems": 6
    },
    "answer": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string", "minLength": 10 },
    "estimated_time_seconds": { "type": "integer", "minimum": 10, "maximum": 600 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 2 }, "minItems": 1 }
  },
  "additionalProperties": false
}
